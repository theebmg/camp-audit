NC_URL=https://nocodb.fracturedrv.com
NC_TOKEN=replace-with-nocodb-api-token
NC_TBL_ASSET_UPDATES=
DATABASE_URL=postgresql://camp_app:replace-with-password@nocodb-db:5432/camp
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=camp-sychar-photos
SPACES_ACCESS_KEY=replace-with-spaces-access-key
SPACES_SECRET_KEY=replace-with-spaces-secret-key
PORT=3000
SESSION_SECRET=replace-with-a-long-random-string

# Outbound email (Reports "email me this" + the Maintenance Request Portal's
# confirmation/status-change/manual emails). GMAIL_USER is the account that
# actually authenticates to Gmail's SMTP relay — MAIL_FROM_ADDRESS can be a
# DIFFERENT address, as long as it's a verified "Send Mail As" alias on
# GMAIL_USER's own account (Gmail > Settings > Accounts > Send mail as). See
# src/mailer.js for the full explanation.
GMAIL_USER=replace-with-the-gmail-account-you-authenticate-as
# Either an App Password (simplest, if available on that account)...
GMAIL_APP_PASSWORD=
# ...or OAuth2, if App Passwords are disabled (e.g. a managed Workspace
# account you don't administer):
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
# The alias address mail appears to come FROM (defaults to GMAIL_USER if unset).
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Camp Sychar Maintenance"
# Where replies should go (defaults to MAIL_FROM_ADDRESS if unset).
MAIL_REPLY_TO=
